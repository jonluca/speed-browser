{
  "name": "speed-browser",
  "main": "main.ts",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "mobile:prepare": "expo prebuild --clean",
    "mobile:submit": "eas build --platform ios --auto-submit --non-interactive"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~56.0.14",
    "@expo/ui": "~56.0.17",
    "@expo/vector-icons": "15.1.1",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.14",
    "expo": "^56.0.9",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.17",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.17",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.6",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.10",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1",
    "typescript": "~6.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260606.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  }
}
